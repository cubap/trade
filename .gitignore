.env
.env.local
.env.*.local

# Build outputs
dist/
build/
# Generated by scripts/sync-vendor-three.mjs (run by server boot or
# `npm run vendor:three`). It is a copy of node_modules/three, so committing it
# would add ~79k lines of third-party code to every diff and get scanned as if
# it were our own source.
vendor/

# Python
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

