# Dependencies
node_modules/
.venv/

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
# vendor/three mirrors the three.js package layout, whose entry points live in
# a build/ directory. Re-include it (the broad rule above would hide it).
!vendor/three/build/

# Python
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Netlify
.netlify/

# Temporary files
docs/TradeGameNotes.extracted.txt
